PORT=4000

# 관리자 비밀번호는 평문으로 저장하지 않는다. bcrypt 해시값만 저장한다.
# 아래 명령으로 해시를 생성한 뒤 결과값을 ADMIN_PASSWORD_HASH에 붙여넣는다.
#   node -e "console.log(require('bcryptjs').hashSync('원하는비밀번호', 10))"
# ADMIN_PASSWORD_HASH=

# 로그인 세션(JWT) 서명에 쓰는 비밀키. 아래 명령으로 만든다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SESSION_SECRET=

# Supabase 프로젝트 설정 > API 메뉴에서 확인 가능.
# 두 값이 모두 있으면 자동으로 Supabase(DB)를 쓰고, 없으면 로컬 JSON 파일을 쓴다.
# SUPABASE_SERVICE_ROLE_KEY는 절대 프론트엔드나 공개 저장소에 노출하면 안 된다.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
